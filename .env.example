# Sentinel Alpha configuration template
# Never commit real secrets.

APP_ENV=development
LOG_LEVEL=INFO

# Current compact MVP persistence. Production deployment may replace this only
# after a deliberate migration and recovery plan is verified.
SENTINEL_DB_PATH=sentinel_alpha.db

# Provider credentials are added only when authorized access is configured.
FRED_API_KEY=
MESSARI_API_KEY=
FINVIZ_API_KEY=
INVO_API_KEY=

# Generate at deployment; never commit the real key.
SENTINEL_MFA_ENCRYPTION_KEY=

# Comma-separated exact browser origins allowed to initiate login in production.
# Example: https://sentinel.example.com
SENTINEL_TRUSTED_ORIGINS=
\n# Comma-separated direct proxy IPs allowed to supply X-Forwarded-For. Leave blank unless deployed behind a trusted proxy.\nSENTINEL_TRUSTED_PROXIES=\n