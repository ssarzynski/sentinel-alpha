# Sentinel Alpha configuration template
# Never commit real secrets.

APP_ENV=development
LOG_LEVEL=INFO

# Current compact MVP persistence. Production deployment may replace this only
# after a deliberate migration and recovery plan is verified.
SENTINEL_DB_PATH=sentinel_alpha.db

# Provider credentials are added only when authorized access is configured.
FRED_API_KEY=
MESSARI_API_KEY=
FINVIZ_API_KEY=
INVO_API_KEY=
